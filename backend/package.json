{
  "name": "leviet-travel-backend",
  "version": "1.0.0",
  "description": "Backend REST API cho Hệ thống Quản lý Du lịch & Tour (LeViet Travel)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seeders/seed.js",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test --test-concurrency=1 test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "sequelize",
    "tour-management",
    "rest-api"
  ],
  "author": "LeViet Travel Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.3.0"
  }
}
