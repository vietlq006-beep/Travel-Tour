# Máy chủ
PORT=5000
NODE_ENV=development
# Chỉ bật khi chạy sau reverse proxy tin cậy (thường là 1 hop)
TRUST_PROXY=

# MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_NAME=leviet_travel_db
DB_USER=root
DB_PASSWORD=change_me
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# JWT: tối thiểu 32 ký tự ngẫu nhiên, không commit giá trị thật
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Vòng đời giữ chỗ
BOOKING_PAYMENT_TTL_MINUTES=30
BOOKING_EXPIRY_JOB_INTERVAL_MS=60000

# CORS; production cần ít nhất một URL
CLIENT_ADMIN_URL=http://localhost:5173
CLIENT_CUSTOMER_URL=http://localhost:5174

# VietQR - Techcombank
VIETQR_BANK_ID=970407
VIETQR_BANK_NAME=Ngân hàng TMCP Kỹ thương Việt Nam (Techcombank)
VIETQR_ACCOUNT_NO=9330302005
VIETQR_ACCOUNT_NAME=LE QUOC VIET
VIETQR_ACCOUNT_DISPLAY_NAME=Lê Quốc Việt

# Webhook đối soát ngân hàng: HMAC SHA-256, tối thiểu 32 ký tự
BANK_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret

# Webhook tùy chọn để chuyển tiếp email/SMS từ notification outbox
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
